<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /CheckMyStars/
    
    # Ne pas réécrire si c'est un fichier réel
    RewriteCond %{REQUEST_FILENAME} !-f
    # Ne pas réécrire si c'est un répertoire réel
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Réécrire les URLs sans extension .php
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [QSA,L]
</IfModule>
